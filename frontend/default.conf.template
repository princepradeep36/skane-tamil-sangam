server {
  listen 80;
  server_name skanetamilsangam.duckdns.org;
  return 301 https://$host$request_uri;
}
server {
  listen 443 ssl;
  server_name skanetamilsangam.duckdns.org;
  ssl_certificate /etc/letsencrypt/live/skanetamilsangam.duckdns.org/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/skanetamilsangam.duckdns.org/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  root /usr/share/nginx/html;
  index index.html;
  location /api/ {
    proxy_pass http://${SITE_BACKEND_HOSTPORT}/api/;
    proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https;
  }
  location /food-api/ {
    proxy_pass http://${FOOD_BACKEND_HOSTPORT}/;
    proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto https;
  }
  location / { try_files $uri $uri/ =404; }
}
